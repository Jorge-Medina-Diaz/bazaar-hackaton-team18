{"actor": "chato", "id": 44601, "payload": {"kind": "persona", "message": 8134, "offer": {"created_tick": 874, "expires_tick": 878, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:SAL-07"]}, "id": 13356, "maker": "chato", "status": "open", "thread": 1251, "to": "t13", "venue": null, "want": {"assets": [], "cash": 33, "types": []}}, "sender": "chato", "team": "t13", "text": "You're Carmen's friend. Mercado de la Paz, 33 P.", "thread": 1251, "with": "chato"}, "scope": "public", "t": 8.6083, "tick": 874, "type": "thread.message"}
