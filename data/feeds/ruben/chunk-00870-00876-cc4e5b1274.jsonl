{"actor": "t07", "id": 44522, "payload": {"kind": "persona", "message": 8122, "offer": {"created_tick": 872, "expires_tick": 876, "final": false, "give": {"assets": [], "cash": 56, "types": []}, "id": 13339, "maker": "t07", "status": "open", "thread": 1242, "to": "chato", "venue": null, "want": {"assets": [], "cash": 0, "types": ["card:RET-10"]}}, "sender": "t07", "team": "t07", "text": null, "thread": 1242, "with": "chato"}, "scope": "public", "t": 8.5917, "tick": 872, "type": "thread.message"}
{"actor": "chato", "id": 44525, "payload": {"kind": "persona", "message": 8118, "offer": {"created_tick": 872, "expires_tick": 876, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:RET-10"]}, "id": 13334, "maker": "chato", "status": "open", "thread": 1242, "to": "t07", "venue": null, "want": {"assets": [], "cash": 90, "types": []}}, "sender": "chato", "team": "t07", "text": "Thirteen from you. Ninety from me. Monumento a Alfonso XII, ninety P. Keep walking up, amigo.", "thread": 1242, "with": "chato"}, "scope": "public", "t": 8.5917, "tick": 872, "type": "thread.message"}
{"actor": "chato", "id": 44528, "payload": {"kind": "persona", "message": 8117, "offer": {"created_tick": 872, "expires_tick": 876, "final": true, "give": {"assets": [], "cash": 0, "types": ["card:SAL-07"]}, "id": 13333, "maker": "chato", "status": "open", "thread": 1238, "to": "t13", "venue": null, "want": {"assets": [], "cash": 29, "types": []}}, "sender": "chato", "team": "t13", "text": "Twenty-six, I move one. Twenty-nine. Last word, no more steps. Take it or I pack up and we both go home.", "thread": 1238, "with": "chato"}, "scope": "public", "t": 8.5917, "tick": 872, "type": "thread.message"}
{"actor": "pilar", "id": 44531, "payload": {"kind": "persona", "message": 8120, "offer": {"created_tick": 872, "expires_tick": 876, "final": false, "give": {"assets": [], "cash": 47, "types": []}, "id": 13336, "maker": "pilar", "status": "open", "thread": 1250, "to": "t05", "venue": null, "want": {"assets": [{"id": 848, "kind": "card", "print_run": 30, "rarity": "rare", "ref": "MAL-09", "serial": 6, "set": "MAL"}], "cash": 0, "types": []}}, "sender": "pilar", "team": "t05", "text": "Buenas tardes. A pleasure. I see you carry La Heroína del Dos de Mayo — a fine Malasaña piece, and my album lacks it. I offer you 47 P for it.", "thread": 1250, "with": "pilar"}, "scope": "public", "t": 8.5917, "tick": 872, "type": "thread.message"}
{"actor": "abuela", "id": 44534, "payload": {"kind": "persona", "message": 8119, "offer": {"created_tick": 872, "expires_tick": 876, "final": false, "give": {"assets": [], "cash": 5, "types": []}, "id": 13335, "maker": "abuela", "status": "open", "thread": 1249, "to": "t04", "venue": null, "want": {"assets": [{"id": 136, "kind": "card", "print_run": 300, "rarity": "common", "ref": "LAT-04", "serial": 4, "set": "LAT"}], "cash": 0, "types": []}}, "sender": "abuela", "team": "t04", "text": "¡Maruja, hija! ¡Qué alegría verte! ¿Has comido ya? Ay, ese Mercado de la Cebada, cuántos domingos allí con mi madre... Mira, cariño, yo te doy 5 por ella. Siéntate un ratito y me cuentas de tu familia, anda.", "thread": 1249, "with": "abuela"}, "scope": "public", "t": 8.5917, "tick": 872, "type": "thread.message"}
