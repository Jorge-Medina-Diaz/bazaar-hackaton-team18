{"actor": "chato", "id": 44594, "payload": {"kind": "persona", "message": 8132, "offer": {"created_tick": 874, "expires_tick": 878, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:RET-10"]}, "id": 13354, "maker": "chato", "status": "cancelled", "thread": 1242, "to": "t07", "venue": null, "want": {"assets": [], "cash": 81, "types": []}}, "sender": "chato", "team": "t07", "text": "Four from you. Four from me. Eighty-one. Monumento a Alfonso XII. Keep climbing, amigo.", "thread": 1242, "with": "chato"}, "scope": "public", "t": 8.6083, "tick": 874, "type": "thread.message"}
{"actor": "pilar", "id": 44597, "payload": {"kind": "persona", "message": 8133, "offer": {"created_tick": 874, "expires_tick": 878, "final": false, "give": {"assets": [], "cash": 49, "types": []}, "id": 13355, "maker": "pilar", "status": "open", "thread": 1250, "to": "t05", "venue": null, "want": {"assets": [{"id": 848, "kind": "card", "print_run": 30, "rarity": "rare", "ref": "MAL-09", "serial": 6, "set": "MAL"}], "cash": 0, "types": []}}, "sender": "pilar", "team": "t05", "text": "Qué amable, but seventy-five is a fantasy, señor mío. I know this print run as I know my own hands. Forty-nine pesetas — that is my word, and it is a courteous one.", "thread": 1250, "with": "pilar"}, "scope": "public", "t": 8.6083, "tick": 874, "type": "thread.message"}
