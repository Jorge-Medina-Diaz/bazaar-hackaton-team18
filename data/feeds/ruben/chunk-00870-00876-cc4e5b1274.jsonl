{"actor": "abuela", "id": 44637, "payload": {"kind": "persona", "message": 8140, "offer": {"created_tick": 875, "expires_tick": 879, "final": true, "give": {"assets": [], "cash": 5, "types": []}, "id": 13366, "maker": "abuela", "status": "open", "thread": 1240, "to": "t15", "venue": null, "want": {"assets": [{"id": 218, "kind": "card", "print_run": 300, "rarity": "common", "ref": "SAL-04", "serial": 8, "set": "SAL"}], "cash": 0, "types": []}}, "sender": "abuela", "team": "t15", "text": "Ay, cariño, qué testarudo, igual que mi Paquito. Pero no, repetidas no compro. Esta es mi última oferta, hijo: Café en Goya, 5 P. Si no la quieres, lo dejamos aquí y tan amigos, ¿eh? Anda, ve a comer algo.", "thread": 1240, "with": "abuela"}, "scope": "public", "t": 8.6167, "tick": 875, "type": "thread.message"}
