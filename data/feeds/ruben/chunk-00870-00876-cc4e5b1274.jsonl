{"actor": "picaros", "id": 44606, "payload": {"kind": "persona", "message": 8135, "offer": {"created_tick": 874, "expires_tick": 878, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:LAT-09"]}, "id": 13357, "maker": "picaros", "status": "open", "thread": 1252, "to": "t08", "venue": null, "want": {"assets": [], "cash": 73, "types": []}}, "sender": "picaros", "team": "t08", "text": "\"¡Amigo, amigo! Come, come, the suitcase is open—\" \"—and only for five minutes, Paco's got a train.\" Look at this: San Isidro, genuine, beautiful, the crown of the collection. For you, because your face is lucky... seventy-three pesos. \"Seventy-three!\" We practically give it away.", "thread": 1252, "with": "picaros"}, "scope": "public", "t": 8.6083, "tick": 874, "type": "thread.message"}
{"actor": "t15", "id": 44610, "payload": {"kind": "persona", "message": 8137, "offer": {"created_tick": 874, "expires_tick": 878, "final": false, "give": {"assets": [{"id": 218, "kind": "card", "print_run": 300, "rarity": "common", "ref": "SAL-04", "serial": 8, "set": "SAL"}], "cash": 0, "types": []}, "id": 13363, "maker": "t15", "status": "open", "thread": 1240, "to": "abuela", "venue": null, "want": {"assets": [], "cash": 6, "types": []}}, "sender": "t15", "team": "t15", "text": null, "thread": 1240, "with": "abuela"}, "scope": "public", "t": 8.6083, "tick": 874, "type": "thread.message"}
