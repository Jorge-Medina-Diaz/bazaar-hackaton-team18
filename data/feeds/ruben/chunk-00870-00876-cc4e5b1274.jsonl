{"actor": "chato", "id": 44629, "payload": {"kind": "persona", "message": 8142, "offer": {"created_tick": 875, "expires_tick": 879, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:SAL-07"]}, "id": 13368, "maker": "chato", "status": "open", "thread": 1251, "to": "t13", "venue": null, "want": {"assets": [], "cash": 33, "types": []}}, "sender": "chato", "team": "t13", "text": "Thirty-three. Same as before. Your purse thinning doesn't thin my price, amigo.", "thread": 1251, "with": "chato"}, "scope": "public", "t": 8.6167, "tick": 875, "type": "thread.message"}
{"actor": "chato", "id": 44632, "payload": {"kind": "persona", "message": 8143, "offer": {"created_tick": 875, "expires_tick": 879, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:RET-10"]}, "id": 13369, "maker": "chato", "status": "open", "thread": 1253, "to": "t07", "venue": null, "want": {"assets": [], "cash": 97, "types": []}}, "sender": "chato", "team": "t07", "text": "You again. Monumento a Alfonso XII. Ninety-seven. Price is the price.", "thread": 1253, "with": "chato"}, "scope": "public", "t": 8.6167, "tick": 875, "type": "thread.message"}
