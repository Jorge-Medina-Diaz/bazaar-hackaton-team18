{"actor": "t04", "id": 44502, "payload": {"kind": "persona", "message": 8114, "offer": {"created_tick": 871, "expires_tick": 875, "final": false, "give": {"assets": [{"id": 136, "kind": "card", "print_run": 300, "rarity": "common", "ref": "LAT-04", "serial": 4, "set": "LAT"}], "cash": 0, "types": []}, "id": 13330, "maker": "t04", "status": "open", "thread": 1249, "to": "abuela", "venue": null, "want": {"assets": [], "cash": 8, "types": []}}, "sender": "t04", "team": "t04", "text": null, "thread": 1249, "with": "abuela"}, "scope": "public", "t": 8.5833, "tick": 871, "type": "thread.message"}
{"actor": "picaros", "id": 44505, "payload": {"kind": "persona", "message": 8112, "offer": {"created_tick": 871, "expires_tick": 875, "final": false, "give": {"assets": [], "cash": 4, "types": []}, "id": 13325, "maker": "picaros", "status": "open", "thread": 1244, "to": "t10", "venue": null, "want": {"assets": [{"id": 366, "kind": "card", "print_run": 300, "rarity": "common", "ref": "LAV-04", "serial": 15, "set": "LAV"}], "cash": 0, "types": []}}, "sender": "picaros", "team": "t10", "text": "\"¡El corazón! Nando, he says *de corazón* —\" \"— I'm weeping, hermano, truly.\" \"Amigo, flattery like that deserves a bargain, and the bargain is four. Four pesos, Mural de la Esquina, into your hands, and we are brothers for life.\" \"The taxi, Paco!\" \"¡Sí! Four. Say it.\"", "thread": 1244, "with": "picaros"}, "scope": "public", "t": 8.5833, "tick": 871, "type": "thread.message"}
