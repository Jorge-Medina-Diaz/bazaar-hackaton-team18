{"actor": "pilar", "id": 50076, "payload": {"kind": "persona", "message": 9476, "offer": {"created_tick": 1000, "expires_tick": 1004, "final": false, "give": {"assets": [], "cash": 16, "types": []}, "id": 15211, "maker": "pilar", "status": "open", "thread": 1468, "to": "t13", "venue": null, "want": {"assets": [{"id": 74, "kind": "card", "print_run": 90, "rarity": "uncommon", "ref": "MAL-08", "serial": 2, "set": "MAL"}], "cash": 0, "types": []}}, "sender": "pilar", "team": "t13", "text": "Buenas tardes. How agreeable to see a new face at my table. I have La Vía Láctea — a lovely piece, rare and properly kept. Sixteen P, and it is yours.", "thread": 1468, "with": "pilar"}, "scope": "public", "t": 9.6583, "tick": 1000, "type": "thread.message"}
