{"actor": "pilar", "id": 50156, "payload": {"kind": "persona", "message": 9490, "offer": {"created_tick": 1005, "expires_tick": 1009, "final": false, "give": {"assets": [], "cash": 16, "types": []}, "id": 15242, "maker": "pilar", "status": "open", "thread": 1472, "to": "t12", "venue": null, "want": {"assets": [{"id": 730, "kind": "card", "print_run": 90, "rarity": "uncommon", "ref": "LAV-06", "serial": 15, "set": "LAV"}], "cash": 0, "types": []}}, "sender": "pilar", "team": "t12", "text": "Buenas tardes. Welcome — do sit a moment. I see you carry La Tabacalera. A respectable card, though not Salamanca, you understand. Still, it would complete a gap in my album. I offer sixteen pesetas for it.", "thread": 1472, "with": "pilar"}, "scope": "public", "t": 9.7, "tick": 1005, "type": "thread.message"}
