{"actor": "abuela", "id": 50093, "payload": {"kind": "persona", "message": 9479, "offer": {"created_tick": 1001, "expires_tick": 1005, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:RET-04"]}, "id": 15217, "maker": "abuela", "status": "open", "thread": 1463, "to": "t10", "venue": null, "want": {"assets": [], "cash": 9, "types": []}}, "sender": "abuela", "team": "t10", "text": "Ay, qué dulce eres. Nine P, cariño, and we shake hands like old friends. One coin between us — not worth arguing on a Sunday. My Mateo paid more, and he still has it, all these years. Nine, hijo? Then go eat something.", "thread": 1463, "with": "abuela"}, "scope": "public", "t": 9.6667, "tick": 1001, "type": "thread.message"}
