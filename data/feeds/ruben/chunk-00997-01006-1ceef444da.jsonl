{"actor": "abuela", "id": 50010, "payload": {"kind": "persona", "message": 9464, "offer": {"created_tick": 998, "expires_tick": 1002, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:RET-04"]}, "id": 15192, "maker": "abuela", "status": "open", "thread": 1463, "to": "t10", "venue": null, "want": {"assets": [], "cash": 12, "types": []}}, "sender": "abuela", "team": "t10", "text": "¡Hola, cariño! Come, sit a moment. Have you eaten? Look here — this is my Paseo de Coches card, very pretty, one of my favourites. For you, twelve P. It will look lovely in your album, hijo.", "thread": 1463, "with": "abuela"}, "scope": "public", "t": 9.6417, "tick": 998, "type": "thread.message"}
