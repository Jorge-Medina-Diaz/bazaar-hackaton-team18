{"actor": "chato", "id": 46485, "payload": {"kind": "persona", "message": 8612, "offer": {"created_tick": 907, "expires_tick": 911, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:LAV-10"]}, "id": 13991, "maker": "chato", "status": "open", "thread": 1303, "to": "t07", "venue": null, "want": {"assets": [], "cash": 78, "types": []}}, "sender": "chato", "team": "t07", "text": "Sixty-seven. You moved, I move. Seventy-eight for the Fiesta de San Cayetano. Clean card, chaval. We're close enough now — don't get greedy.", "thread": 1303, "with": "chato"}, "scope": "public", "t": 8.8833, "tick": 907, "type": "thread.message"}
{"actor": "abuela", "id": 46489, "payload": {"kind": "persona", "message": 8615, "offer": null, "sender": "abuela", "team": "t07", "text": "Ay, cariño, come, look all you like — but today I cannot go further with the price, no more. My old head is tired and the sun is strong. Come back next Sunday, eh? And eat something first, hijo, you look hungry. Un beso.", "thread": 1321, "with": "abuela"}, "scope": "public", "t": 8.8833, "tick": 907, "type": "thread.message"}
