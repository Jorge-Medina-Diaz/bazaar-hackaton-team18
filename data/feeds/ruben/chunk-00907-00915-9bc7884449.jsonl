{"actor": "abuela", "id": 46539, "payload": {"kind": "persona", "message": 8626, "offer": null, "sender": "abuela", "team": "t07", "text": "Ay, cariño, come in, come in — but today I cannot go further than I have, eh? My old head is tired and the table is almost packed. Come back next Sunday, I keep something nice for you. Have you eaten? Go, eat something warm. Un beso, hijo.", "thread": 1323, "with": "abuela"}, "scope": "public", "t": 8.9, "tick": 909, "type": "thread.message"}
{"actor": "t07", "id": 46543, "payload": {"kind": "persona", "message": 8629, "offer": {"created_tick": 910, "expires_tick": 914, "final": false, "give": {"assets": [{"id": 849, "kind": "card", "print_run": 300, "rarity": "common", "ref": "RET-02", "serial": 9, "set": "RET"}], "cash": 0, "types": []}, "id": 14019, "maker": "t07", "status": "open", "thread": 1317, "to": "picaros", "venue": null, "want": {"assets": [], "cash": 6, "types": []}}, "sender": "t07", "team": "t07", "text": null, "thread": 1317, "with": "picaros"}, "scope": "public", "t": 8.9083, "tick": 910, "type": "thread.message"}
