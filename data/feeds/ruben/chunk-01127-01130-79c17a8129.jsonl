{"actor": "t07", "id": 55258, "payload": {"kind": "persona", "message": 10674, "offer": {"created_tick": 1130, "expires_tick": 1134, "final": false, "give": {"assets": [{"id": 1092, "kind": "card", "print_run": 300, "rarity": "common", "ref": "LAV-03", "serial": 27, "set": "LAV"}], "cash": 0, "types": []}, "id": 16963, "maker": "t07", "status": "open", "thread": 1699, "to": "abuela", "venue": null, "want": {"assets": [], "cash": 14, "types": []}}, "sender": "t07", "team": "t07", "text": null, "thread": 1699, "with": "abuela"}, "scope": "public", "t": 10.7417, "tick": 1130, "type": "thread.message"}
{"actor": "t16", "id": 55261, "payload": {"offer": {"created_tick": 1130, "expires_tick": 1140, "final": false, "give": {"assets": [{"id": 1005, "kind": "card", "print_run": 300, "rarity": "common", "ref": "MAL-03", "serial": 19, "set": "MAL"}], "cash": 0, "types": []}, "id": 16964, "maker": "t16", "status": "open", "thread": null, "to": "t12", "venue": "rastro", "want": {"assets": [], "cash": 7, "types": []}}, "venue": "rastro"}, "scope": "public", "t": 10.7417, "tick": 1130, "type": "offer.listed"}
{"actor": "t16", "id": 55262, "payload": {"offer": {"created_tick": 1130, "expires_tick": 1140, "final": false, "give": {"assets": [{"id": 199, "kind": "card", "print_run": 300, "rarity": "common", "ref": "MAL-05", "serial": 6, "set": "MAL"}], "cash": 0, "types": []}, "id": 16965, "maker": "t16", "status": "open", "thread": null, "to": "t08", "venue": "rastro", "want": {"assets": [], "cash": 7, "types": []}}, "venue": "rastro"}, "scope": "public", "t": 10.7417, "tick": 1130, "type": "offer.listed"}
{"actor": "abuela", "id": 55266, "payload": {"kind": "persona", "message": 10669, "offer": {"created_tick": 1130, "expires_tick": 1134, "final": false, "give": {"assets": [], "cash": 6, "types": []}, "id": 16958, "maker": "abuela", "status": "open", "thread": 1699, "to": "t07", "venue": null, "want": {"assets": [{"id": 1092, "kind": "card", "print_run": 300, "rarity": "common", "ref": "LAV-03", "serial": 27, "set": "LAV"}], "cash": 0, "types": []}}, "sender": "abuela", "team": "t07", "text": "Ay, hijo, qué cabezón eres — but a sweet one. Mira, six P, and that is me being greedy for once, eh? Not sixteen, never. Take the card, and go eat something. And swap those duplicates — a full page is worth much more than loose cards, cariño.", "thread": 1699, "with": "abuela"}, "scope": "public", "t": 10.7417, "tick": 1130, "type": "thread.message"}
