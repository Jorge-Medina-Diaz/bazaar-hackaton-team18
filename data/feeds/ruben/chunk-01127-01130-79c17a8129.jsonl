{"actor": "picaros", "id": 55178, "payload": {"kind": "persona", "message": 10654, "offer": {"created_tick": 1128, "expires_tick": 1132, "final": false, "give": {"assets": [], "cash": 4, "types": []}, "id": 16939, "maker": "picaros", "status": "open", "thread": 1700, "to": "t03", "venue": null, "want": {"assets": [{"id": 1073, "kind": "card", "print_run": 300, "rarity": "common", "ref": "SAL-03", "serial": 28, "set": "SAL"}], "cash": 0, "types": []}}, "sender": "picaros", "team": "t03", "text": "Nando, he's robbing us! Fine, 4 P.", "thread": 1700, "with": "picaros"}, "scope": "public", "t": 10.725, "tick": 1128, "type": "thread.message"}
{"actor": "t07", "id": 55181, "payload": {"offer": {"created_tick": 1128, "expires_tick": 1133, "final": false, "give": {"assets": [], "cash": 56, "types": []}, "id": 16941, "maker": "t07", "status": "open", "thread": null, "to": null, "venue": "rastro", "want": {"assets": [], "cash": 0, "types": ["card:RET-10"]}}, "venue": "rastro"}, "scope": "public", "t": 10.725, "tick": 1128, "type": "offer.listed"}
{"actor": "abuela", "id": 55182, "payload": {"kind": "persona", "message": 10655, "offer": {"created_tick": 1128, "expires_tick": 1132, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:SAL-07"]}, "id": 16940, "maker": "abuela", "status": "open", "thread": 1701, "to": "t10", "venue": null, "want": {"assets": [], "cash": 29, "types": []}}, "sender": "abuela", "team": "t10", "text": "Ay, hola cariño! Come, sit a moment. Have you eaten? Look here — Mercado de la Paz, a lovely one, for 29 P. And a little advice, hijo: a full page is worth much more than loose cards. Swap your duplicates, always!", "thread": 1701, "with": "abuela"}, "scope": "public", "t": 10.725, "tick": 1128, "type": "thread.message"}
{"actor": "t09", "id": 55185, "payload": {"offer": {"created_tick": 1128, "expires_tick": 1188, "final": false, "give": {"assets": [], "cash": 20, "types": []}, "id": 16942, "maker": "t09", "status": "open", "thread": null, "to": null, "venue": "rastro", "want": {"assets": [], "cash": 0, "types": ["card:MAL-06"]}}, "venue": "rastro"}, "scope": "public", "t": 10.725, "tick": 1128, "type": "offer.listed"}
{"actor": "abuela", "id": 55186, "payload": {"kind": "persona", "message": 10653, "offer": {"created_tick": 1128, "expires_tick": 1132, "final": false, "give": {"assets": [], "cash": 5, "types": []}, "id": 16938, "maker": "abuela", "status": "open", "thread": 1699, "to": "t07", "venue": null, "want": {"assets": [{"id": 1092, "kind": "card", "print_run": 300, "rarity": "common", "ref": "LAV-03", "serial": 27, "set": "LAV"}], "cash": 0, "types": []}}, "sender": "abuela", "team": "t07", "text": "Ay, hijo, no, no — twenty is too much! Five P, like I said. I don't take more than a thing is worth. Keep the rest for your duplicates — swap them, a full page is worth much more than loose cards. And El Chato, next stall, opens for everyone at half past nine tonight. He likes straight traders.", "thread": 1699, "with": "abuela"}, "scope": "public", "t": 10.725, "tick": 1128, "type": "thread.message"}
{"actor": "", "id": 55189, "payload": {"kind": "persona", "team": "t10", "thread": 1703, "topic": {"sell": {"assets": [1121]}}, "with": "pilar"}, "scope": "public", "t": 10.725, "tick": 1128, "type": "thread.opened"}
{"actor": "picaros", "id": 55190, "payload": {"kind": "persona", "message": 10652, "offer": {"created_tick": 1128, "expires_tick": 1132, "final": false, "give": {"assets": [], "cash": 4, "types": []}, "id": 16937, "maker": "picaros", "status": "open", "thread": 1698, "to": "t06", "venue": null, "want": {"assets": [{"id": 1097, "kind": "card", "print_run": 300, "rarity": "common", "ref": "LAT-05", "serial": 22, "set": "LAT"}], "cash": 0, "types": []}}, "sender": "picaros", "team": "t06", "text": "¡Eh, amigo, cinco no hace falta! Cuatro primas, El Organillero, y cerramos ahora mismo. Nando, diles... —Sí, los de la caseta de al lado ya vienen con el dinero en la mano, pero tú nos caes mejor, hombre. Cuatro, un apretón de manos, y la pieza es tuya. ¿Vamos?", "thread": 1698, "with": "picaros"}, "scope": "public", "t": 10.725, "tick": 1128, "type": "thread.message"}
{"actor": "t10", "id": 55193, "payload": {"kind": "persona", "message": 10656, "offer": {"created_tick": 1128, "expires_tick": 1132, "final": false, "give": {"assets": [{"id": 1121, "kind": "card", "print_run": 30, "rarity": "rare", "ref": "SAL-09", "serial": 21, "set": "SAL"}], "cash": 0, "types": []}, "id": 16943, "maker": "t10", "status": "open", "thread": 1703, "to": "pilar", "venue": null, "want": {"assets": [], "cash": 100, "types": []}}, "sender": "t10", "team": "t10", "text": null, "thread": 1703, "with": "pilar"}, "scope": "public", "t": 10.725, "tick": 1128, "type": "thread.message"}
