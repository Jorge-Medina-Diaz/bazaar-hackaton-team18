{"actor": "t07", "id": 55203, "payload": {"kind": "persona", "message": 10659, "offer": {"created_tick": 1128, "expires_tick": 1132, "final": false, "give": {"assets": [{"id": 1092, "kind": "card", "print_run": 300, "rarity": "common", "ref": "LAV-03", "serial": 27, "set": "LAV"}], "cash": 0, "types": []}, "id": 16946, "maker": "t07", "status": "open", "thread": 1699, "to": "abuela", "venue": null, "want": {"assets": [], "cash": 18, "types": []}}, "sender": "t07", "team": "t07", "text": null, "thread": 1699, "with": "abuela"}, "scope": "public", "t": 10.725, "tick": 1128, "type": "thread.message"}
