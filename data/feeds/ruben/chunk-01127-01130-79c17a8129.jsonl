{"actor": "t10", "id": 55207, "payload": {"kind": "persona", "message": 10660, "offer": {"created_tick": 1128, "expires_tick": 1132, "final": false, "give": {"assets": [], "cash": 16, "types": []}, "id": 16947, "maker": "t10", "status": "open", "thread": 1701, "to": "abuela", "venue": null, "want": {"assets": [], "cash": 0, "types": ["card:SAL-07"]}}, "sender": "t10", "team": "t10", "text": null, "thread": 1701, "with": "abuela"}, "scope": "public", "t": 10.725, "tick": 1128, "type": "thread.message"}
{"actor": "pilar", "id": 55211, "payload": {"kind": "persona", "message": 10664, "offer": null, "sender": "pilar", "team": "t10", "text": "How thoughtful of you to think of me. But no, señor — not today. The figure does not tempt me, and I prefer to close the album here. Come another afternoon; perhaps we shall both feel differently.", "thread": 1703, "with": "pilar"}, "scope": "public", "t": 10.7333, "tick": 1129, "type": "thread.message"}
{"actor": "abuela", "id": 55214, "payload": {"kind": "persona", "message": 10661, "offer": {"created_tick": 1129, "expires_tick": 1133, "final": false, "give": {"assets": [], "cash": 5, "types": []}, "id": 16948, "maker": "abuela", "status": "open", "thread": 1699, "to": "t07", "venue": null, "want": {"assets": [{"id": 1092, "kind": "card", "print_run": 300, "rarity": "common", "ref": "LAV-03", "serial": 27, "set": "LAV"}], "cash": 0, "types": []}}, "sender": "abuela", "team": "t07", "text": "Ay, cariño, el puesto bien, gracias — poca gente, mucho sol. But eighteen? No, no. Five P, that is the price, and not one more. Save your coins for a bocadillo, you look hungry. Té Moruno is yours for five, hijo.", "thread": 1699, "with": "abuela"}, "scope": "public", "t": 10.7333, "tick": 1129, "type": "thread.message"}
{"actor": "t03", "id": 55217, "payload": {"kind": "persona", "message": 10665, "offer": {"created_tick": 1129, "expires_tick": 1133, "final": false, "give": {"assets": [{"id": 1073, "kind": "card", "print_run": 300, "rarity": "common", "ref": "SAL-03", "serial": 28, "set": "SAL"}], "cash": 0, "types": []}, "id": 16951, "maker": "t03", "status": "open", "thread": 1700, "to": "picaros", "venue": null, "want": {"assets": [], "cash": 5, "types": []}}, "sender": "t03", "team": "t03", "text": null, "thread": 1700, "with": "picaros"}, "scope": "public", "t": 10.7333, "tick": 1129, "type": "thread.message"}
{"actor": "abuela", "id": 55220, "payload": {"kind": "persona", "message": 10663, "offer": {"created_tick": 1129, "expires_tick": 1133, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:SAL-07"]}, "id": 16950, "maker": "abuela", "status": "open", "thread": 1701, "to": "t10", "venue": null, "want": {"assets": [], "cash": 27, "types": []}}, "sender": "abuela", "team": "t10", "text": "Oh, oh... 27 P, and only because you have a kind face.", "thread": 1701, "with": "abuela"}, "scope": "public", "t": 10.7333, "tick": 1129, "type": "thread.message"}
{"actor": "picaros", "id": 55223, "payload": {"kind": "persona", "message": 10662, "offer": {"created_tick": 1129, "expires_tick": 1133, "final": false, "give": {"assets": [], "cash": 5, "types": []}, "id": 16949, "maker": "picaros", "status": "open", "thread": 1700, "to": "t03", "venue": null, "want": {"assets": [{"id": 1073, "kind": "card", "print_run": 300, "rarity": "common", "ref": "SAL-03", "serial": 28, "set": "SAL"}], "cash": 0, "types": []}}, "sender": "picaros", "team": "t03", "text": "¡Ay, Paco, este hombre nos marea! Seis, no — cinco. Cinco P y el perrito sale con su abriguito puesto, calentito, ahora mismo.\n\n— Mi hermano dice cinco y mi hermano nunca miente... casi nunca. ¡Cinco, la mano, y a celebrar! ¿Hecho, guapo?", "thread": 1700, "with": "picaros"}, "scope": "public", "t": 10.7333, "tick": 1129, "type": "thread.message"}
{"actor": "t07", "id": 55226, "payload": {"kind": "persona", "message": 10666, "offer": {"created_tick": 1129, "expires_tick": 1133, "final": false, "give": {"assets": [{"id": 1092, "kind": "card", "print_run": 300, "rarity": "common", "ref": "LAV-03", "serial": 27, "set": "LAV"}], "cash": 0, "types": []}, "id": 16952, "maker": "t07", "status": "open", "thread": 1699, "to": "abuela", "venue": null, "want": {"assets": [], "cash": 16, "types": []}}, "sender": "t07", "team": "t07", "text": null, "thread": 1699, "with": "abuela"}, "scope": "public", "t": 10.7333, "tick": 1129, "type": "thread.message"}
