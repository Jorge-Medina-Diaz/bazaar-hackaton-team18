{"actor": "chato", "id": 106872, "payload": {"kind": "persona", "message": 18325, "offer": {"created_tick": 2453, "expires_tick": 2461, "final": false, "give": {"assets": [], "cash": 39, "types": []}, "id": 27519, "maker": "chato", "status": "open", "thread": 3868, "to": "t06", "venue": null, "want": {"assets": [{"id": 1166, "kind": "card", "print_run": 30, "rarity": "rare", "ref": "LAT-09", "serial": 9, "set": "LAT"}], "cash": 0, "types": []}}, "sender": "chato", "team": "t06", "text": "Vermut's nice. Price isn't. 39. You moved three, I move none. That's how it works.", "thread": 3868, "with": "chato"}, "scope": "public", "t": 17.8292, "tick": 2453, "type": "thread.message"}
{"actor": "abuela", "id": 106875, "payload": {"kind": "persona", "message": 18326, "offer": {"created_tick": 2453, "expires_tick": 2461, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:RET-02"]}, "id": 27520, "maker": "abuela", "status": "open", "thread": 3880, "to": "t08", "venue": null, "want": {"assets": [], "cash": 12, "types": []}}, "sender": "abuela", "team": "t08", "text": "Ay, hola cariño, come, come, sit a little. Have you eaten today? Look here — La Castañera, she is lovely, no? My favourite card since many years. For you, twelve P. Take your time, mi hijo, I am not going anywhere.", "thread": 3880, "with": "abuela"}, "scope": "public", "t": 17.8292, "tick": 2453, "type": "thread.message"}
