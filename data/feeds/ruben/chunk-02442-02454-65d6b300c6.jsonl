{"actor": "picaros", "id": 106709, "payload": {"kind": "persona", "message": 18295, "offer": {"created_tick": 2446, "expires_tick": 2454, "final": false, "give": {"assets": [], "cash": 4, "types": []}, "id": 27480, "maker": "picaros", "status": "open", "thread": 3857, "to": "t13", "venue": null, "want": {"assets": [{"id": 1408, "kind": "card", "print_run": 300, "rarity": "common", "ref": "SAL-01", "serial": 26, "set": "SAL"}], "cash": 0, "types": []}}, "sender": "picaros", "team": "t13", "text": "¡Siete! Paco: ¡ay, el corazón! Nando: amigo, si bajas así, bajamos juntos al río. Paco: cuatro primas por el Escaparate de Serrano, en la mano, contadas y calentitas. Nando: el mozo ya carga la maleta... Paco: ¡y el tren no espera a nadie! ¿Trato, campeón? Di que sí.", "thread": 3857, "with": "picaros"}, "scope": "public", "t": 17.8, "tick": 2446, "type": "thread.message"}
