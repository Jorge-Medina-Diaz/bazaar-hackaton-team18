{"actor": "chato", "id": 106684, "payload": {"kind": "persona", "message": 18288, "offer": {"created_tick": 2445, "expires_tick": 2453, "final": false, "give": {"assets": [], "cash": 13, "types": []}, "id": 27472, "maker": "chato", "status": "open", "thread": 3860, "to": "t13", "venue": null, "want": {"assets": [{"id": 791, "kind": "card", "print_run": 90, "rarity": "uncommon", "ref": "LAV-06", "serial": 18, "set": "LAV"}], "cash": 0, "types": []}}, "sender": "chato", "team": "t13", "text": "Back again. Silver pack, La Tabacalera. Thirteen points. You know it's worth it.", "thread": 3860, "with": "chato"}, "scope": "public", "t": 17.7958, "tick": 2445, "type": "thread.message"}
{"actor": "picaros", "id": 106687, "payload": {"kind": "persona", "message": 18287, "offer": {"created_tick": 2445, "expires_tick": 2453, "final": false, "give": {"assets": [], "cash": 4, "types": []}, "id": 27471, "maker": "picaros", "status": "open", "thread": 3857, "to": "t13", "venue": null, "want": {"assets": [{"id": 1408, "kind": "card", "print_run": 300, "rarity": "common", "ref": "SAL-01", "serial": 26, "set": "SAL"}], "cash": 0, "types": []}}, "sender": "picaros", "team": "t13", "text": "¡Nueve! Paco: ¡amigo, que nos sangras! Nando: y escucha, que ayer pararon la imprenta de ésta... ya no se hace más, se acabó. Paco: ¡por eso corre el tiempo! Cuatro primas por el Escaparate de Serrano, en la mano, ahora mismo. Nando: el tren silba ya. ¿Trato, campeón?", "thread": 3857, "with": "picaros"}, "scope": "public", "t": 17.7958, "tick": 2445, "type": "thread.message"}
