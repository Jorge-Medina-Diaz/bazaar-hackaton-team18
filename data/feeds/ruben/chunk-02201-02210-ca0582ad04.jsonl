{"actor": "chato", "id": 98843, "payload": {"kind": "persona", "message": 16567, "offer": {"created_tick": 2204, "expires_tick": 2212, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:RET-06"]}, "id": 25560, "maker": "chato", "status": "open", "thread": 3247, "to": "t17", "venue": null, "want": {"assets": [], "cash": 33, "types": []}}, "sender": "chato", "team": "t17", "text": "Thirty-three. Same number as a minute ago. I don't move because you said a smaller one.", "thread": 3247, "with": "chato"}, "scope": "public", "t": 16.7917, "tick": 2204, "type": "thread.message"}
{"actor": "", "id": 98849, "payload": {"kind": "persona", "team": "t07", "thread": 3254, "topic": {"sell": {"assets": [1096]}}, "with": "pilar"}, "scope": "public", "t": 16.7917, "tick": 2204, "type": "thread.opened"}
{"actor": "abuela", "id": 98851, "payload": {"kind": "persona", "message": 16568, "offer": {"created_tick": 2204, "expires_tick": 2212, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:RET-05"]}, "id": 25561, "maker": "abuela", "status": "open", "thread": 3248, "to": "t17", "venue": null, "want": {"assets": [], "cash": 10, "types": []}}, "sender": "abuela", "team": "t17", "text": "Ay, cariño, four? She is a pretty squirrel, that one! Look — ten P, and I am happy. Keep your duplicates for swapping, eh? And go see El Chato next door, he opens for everybody at half past nine tonight. He likes honest traders like you.", "thread": 3248, "with": "abuela"}, "scope": "public", "t": 16.7917, "tick": 2204, "type": "thread.message"}
