{"actor": "t07", "id": 98791, "payload": {"kind": "persona", "message": 16563, "offer": {"created_tick": 2203, "expires_tick": 2211, "final": false, "give": {"assets": [{"id": 291, "kind": "card", "print_run": 300, "rarity": "common", "ref": "MAL-05", "serial": 8, "set": "MAL"}], "cash": 0, "types": []}, "id": 25554, "maker": "t07", "status": "open", "thread": 3238, "to": "abuela", "venue": null, "want": {"assets": [], "cash": 14, "types": []}}, "sender": "t07", "team": "t07", "text": null, "thread": 3238, "with": "abuela"}, "scope": "public", "t": 16.7875, "tick": 2203, "type": "thread.message"}
{"actor": "chato", "id": 98794, "payload": {"kind": "persona", "message": 16561, "offer": {"created_tick": 2203, "expires_tick": 2211, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:RET-06"]}, "id": 25552, "maker": "chato", "status": "open", "thread": 3247, "to": "t17", "venue": null, "want": {"assets": [], "cash": 33, "types": []}}, "sender": "chato", "team": "t17", "text": "You again. La Rosaleda. Thirty-three. That is the number, not the start of a conversation.", "thread": 3247, "with": "chato"}, "scope": "public", "t": 16.7875, "tick": 2203, "type": "thread.message"}
{"actor": "abuela", "id": 98797, "payload": {"kind": "persona", "message": 16562, "offer": {"created_tick": 2203, "expires_tick": 2211, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:RET-05"]}, "id": 25553, "maker": "abuela", "status": "open", "thread": 3248, "to": "t17", "venue": null, "want": {"assets": [], "cash": 12, "types": []}}, "sender": "abuela", "team": "t17", "text": "Hola, cariño! Come, sit a little. Have you eaten? This one here, La Ardilla, she is lovely — twelve P for you. And a little advice, hijo: a full page is worth much more than loose cards, so swap your duplicates, eh?", "thread": 3248, "with": "abuela"}, "scope": "public", "t": 16.7875, "tick": 2203, "type": "thread.message"}
{"actor": "abuela", "id": 98800, "payload": {"kind": "persona", "message": 16560, "offer": {"created_tick": 2203, "expires_tick": 2211, "final": false, "give": {"assets": [], "cash": 5, "types": []}, "id": 25551, "maker": "abuela", "status": "open", "thread": 3238, "to": "t07", "venue": null, "want": {"assets": [{"id": 291, "kind": "card", "print_run": 300, "rarity": "common", "ref": "MAL-05", "serial": 8, "set": "MAL"}], "cash": 0, "types": []}}, "sender": "abuela", "team": "t07", "text": "Ay, hijo, you make me laugh — sixteen! No, no. Five P, that is my price and it does not move. Keep your coins for something to eat, anda. Take the card, cuídala bien, and come show me your album next Sunday, cariño.", "thread": 3238, "with": "abuela"}, "scope": "public", "t": 16.7875, "tick": 2203, "type": "thread.message"}
