{"actor": "abuela", "id": 98774, "payload": {"kind": "persona", "message": 16558, "offer": {"created_tick": 2202, "expires_tick": 2210, "final": false, "give": {"assets": [], "cash": 5, "types": []}, "id": 25546, "maker": "abuela", "status": "open", "thread": 3238, "to": "t07", "venue": null, "want": {"assets": [{"id": 291, "kind": "card", "print_run": 300, "rarity": "common", "ref": "MAL-05", "serial": 8, "set": "MAL"}], "cash": 0, "types": []}}, "sender": "abuela", "team": "t07", "text": "Look, 5 P. My grandchildren would pay more! A little advice, cariño: a full page is worth much more than the loose cards. Swap your duplicates!", "thread": 3238, "with": "abuela"}, "scope": "public", "t": 16.7833, "tick": 2202, "type": "thread.message"}
