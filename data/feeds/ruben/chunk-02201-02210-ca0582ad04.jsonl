{"actor": "banco", "id": 98892, "payload": {"kind": "persona", "message": 16584, "offer": {"created_tick": 2206, "expires_tick": 2214, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:MAL-12"]}, "id": 25580, "maker": "banco", "status": "open", "thread": 3249, "to": "t12", "venue": null, "want": {"assets": [], "cash": 761, "types": []}}, "sender": "banco", "team": "t12", "text": "Paciencia I have in abundance, señor. But my terms do not move with the hour. La Reina de la Movida: 761. She waits in the vault either way.", "thread": 3249, "with": "banco"}, "scope": "public", "t": 16.8, "tick": 2206, "type": "thread.message"}
