{"actor": "t17", "id": 98964, "payload": {"offer": {"created_tick": 2209, "expires_tick": 2269, "final": false, "give": {"assets": [], "cash": 6, "types": []}, "id": 25600, "maker": "t17", "status": "open", "thread": null, "to": "t16", "venue": "rastro", "want": {"assets": [], "cash": 0, "types": ["card:RET-05"]}}, "venue": "rastro"}, "scope": "public", "t": 16.8125, "tick": 2209, "type": "offer.listed"}
{"actor": "banco", "id": 98965, "payload": {"kind": "persona", "message": 16601, "offer": {"created_tick": 2209, "expires_tick": 2217, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:MAL-12"]}, "id": 25598, "maker": "banco", "status": "open", "thread": 3249, "to": "t12", "venue": null, "want": {"assets": [], "cash": 755, "types": []}}, "sender": "banco", "team": "t12", "text": "Señor, your steps are smaller than my patience is long. La Reina de la Movida: 755. Come with a real number, or let her rest.", "thread": 3249, "with": "banco"}, "scope": "public", "t": 16.8125, "tick": 2209, "type": "thread.message"}
{"actor": "picaros", "id": 98968, "payload": {"kind": "persona", "message": 16602, "offer": {"created_tick": 2209, "expires_tick": 2217, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:MAL-11"]}, "id": 25599, "maker": "picaros", "status": "open", "thread": 3255, "to": "t04", "venue": null, "want": {"assets": [], "cash": 163, "types": []}}, "sender": "picaros", "team": "t04", "text": "¡Mole poblano! Paco ya está soñando. Nando dice que el mole de tu mamá vale más que esta carta — casi. Por los camotes y por tu hermano: 163 P la Pentagrama. Mírala brillar, primo. El maletín ya cruje, dale, ¿cerramos?", "thread": 3255, "with": "picaros"}, "scope": "public", "t": 16.8125, "tick": 2209, "type": "thread.message"}
