{"actor": "abuela", "id": 98896, "payload": {"kind": "persona", "message": 16583, "offer": {"created_tick": 2206, "expires_tick": 2214, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:RET-05"]}, "id": 25579, "maker": "abuela", "status": "open", "thread": 3248, "to": "t17", "venue": null, "want": {"assets": [], "cash": 9, "types": []}}, "sender": "abuela", "team": "t17", "text": "Ay, hijo, you bargain like my late Paco, que en paz descanse. Nine P, and I give you a smile for free. Eat something later, eh? And remember El Chato at half past nine — he likes straight traders like you. Swap those duplicates, finish your page!", "thread": 3248, "with": "abuela"}, "scope": "public", "t": 16.8, "tick": 2206, "type": "thread.message"}
