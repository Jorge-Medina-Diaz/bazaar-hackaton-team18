{"actor": "abuela", "id": 98813, "payload": {"kind": "persona", "message": 16566, "offer": {"created_tick": 2204, "expires_tick": 2212, "final": false, "give": {"assets": [], "cash": 5, "types": []}, "id": 25559, "maker": "abuela", "status": "open", "thread": 3238, "to": "t07", "venue": null, "want": {"assets": [{"id": 291, "kind": "card", "print_run": 300, "rarity": "common", "ref": "MAL-05", "serial": 8, "set": "MAL"}], "cash": 0, "types": []}}, "sender": "abuela", "team": "t07", "text": "Oh, oh... 5 P, and only because you have a kind face. El Chato, the next stall, opens for everyone at half past nine tonight. He likes people who trade straight.", "thread": 3238, "with": "abuela"}, "scope": "public", "t": 16.7917, "tick": 2204, "type": "thread.message"}
