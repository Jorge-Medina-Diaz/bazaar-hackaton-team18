{"actor": "abuela", "id": 98886, "payload": {"kind": "persona", "message": 16582, "offer": {"created_tick": 2206, "expires_tick": 2214, "final": true, "give": {"assets": [], "cash": 6, "types": []}, "id": 25578, "maker": "abuela", "status": "open", "thread": 3238, "to": "t07", "venue": null, "want": {"assets": [{"id": 291, "kind": "card", "print_run": 300, "rarity": "common", "ref": "MAL-05", "serial": 8, "set": "MAL"}], "cash": 0, "types": []}}, "sender": "abuela", "team": "t07", "text": "Oh, oh... 6 P, and only because you have a kind face. Look, cariño, I can't go lower. This is my last offer.", "thread": 3238, "with": "abuela"}, "scope": "public", "t": 16.8, "tick": 2206, "type": "thread.message"}
