{"actor": "chato", "id": 57409, "payload": {"kind": "persona", "message": 11096, "offer": {"created_tick": 1200, "expires_tick": 1204, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:LAV-10"]}, "id": 17729, "maker": "chato", "status": "open", "thread": 1793, "to": "t13", "venue": null, "want": {"assets": [], "cash": 97, "types": []}}, "sender": "chato", "team": "t13", "text": "Tu nieta tiene buen gusto. 97 primas. No me he movido, y tú tampoco mucho.", "thread": 1793, "with": "chato"}, "scope": "public", "t": 11.325, "tick": 1200, "type": "thread.message"}
{"actor": "picaros", "id": 57412, "payload": {"kind": "persona", "message": 11097, "offer": {"created_tick": 1200, "expires_tick": 1204, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:SAL-10"]}, "id": 17730, "maker": "picaros", "status": "open", "thread": 1794, "to": "t10", "venue": null, "want": {"assets": [], "cash": 73, "types": []}}, "sender": "picaros", "team": "t10", "text": "¡Amigo, amigo! Paco here, this is Nando — you have the face of a collector, no?\n\nLook, look: Museo Lázaro Galdiano. Beautiful card, hardly ever comes out of the case. Seventy-three pesos and it is yours, right now.\n\nNando: We leave at noon, eh. After that, who knows!", "thread": 1794, "with": "picaros"}, "scope": "public", "t": 11.325, "tick": 1200, "type": "thread.message"}
