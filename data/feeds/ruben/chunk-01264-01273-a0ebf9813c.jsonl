{"actor": "t04", "id": 61771, "payload": {"kind": "persona", "message": 11580, "offer": {"created_tick": 1268, "expires_tick": 1272, "final": false, "give": {"assets": [], "cash": 101, "types": []}, "id": 18556, "maker": "t04", "status": "open", "thread": 1913, "to": "picaros", "venue": null, "want": {"assets": [], "cash": 0, "types": ["card:SAL-11"]}}, "sender": "t04", "team": "t04", "text": null, "thread": 1913, "with": "picaros"}, "scope": "public", "t": 11.8917, "tick": 1268, "type": "thread.message"}
{"actor": "picaros", "id": 61785, "payload": {"kind": "persona", "message": 11579, "offer": {"created_tick": 1268, "expires_tick": 1272, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:LAV-11"]}, "id": 18555, "maker": "picaros", "status": "open", "thread": 1917, "to": "t10", "venue": null, "want": {"assets": [], "cash": 187, "types": []}}, "sender": "picaros", "team": "t10", "text": "¡Amigo, amigo, come close! Paco here, this is Nando — look, look, La Casa Encendida, pure fire, pure gold.\n\n\"For you, 187 P!\"\n\n\"Only for you, because your face we like!\"\n\nQuick, quick, the van is running, we leave in one minute — after that, puf, we are gone. ¿Sí?", "thread": 1917, "with": "picaros"}, "scope": "public", "t": 11.8917, "tick": 1268, "type": "thread.message"}
