{"actor": "abuela", "id": 81359, "payload": {"kind": "persona", "message": 14667, "offer": {"created_tick": 1776, "expires_tick": 1784, "final": false, "give": {"assets": [], "cash": 0, "types": ["pack:sobre_barrio"]}, "id": 22589, "maker": "abuela", "status": "open", "thread": 2630, "to": "t02", "venue": null, "want": {"assets": [], "cash": 30, "types": []}}, "sender": "abuela", "team": "t02", "text": "¿Cómo, hijo? I did not hear well, my ears are old. The Neighbourhood pack, thirty P — that is my offer, cariño. Good cards for a beginner. Sit, look at them slowly. Nobody is rushing you here, I promise.", "thread": 2630, "with": "abuela"}, "scope": "public", "t": 15.0083, "tick": 1776, "type": "thread.message"}
