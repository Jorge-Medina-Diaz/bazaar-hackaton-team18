{"actor": "t10", "id": 81269, "payload": {"kind": "persona", "message": 14650, "offer": null, "sender": "t10", "team": "t10", "text": null, "thread": 2619, "with": "pilar"}, "scope": "public", "t": 14.975, "tick": 1768, "type": "thread.message"}
{"actor": "pilar", "id": 81273, "payload": {"kind": "persona", "message": 14652, "offer": {"created_tick": 1769, "expires_tick": 1777, "final": false, "give": {"assets": [], "cash": 0, "types": ["pack:sobre_oro"]}, "id": 22567, "maker": "pilar", "status": "open", "thread": 2619, "to": "t10", "venue": null, "want": {"assets": [], "cash": 504, "types": []}}, "sender": "pilar", "team": "t10", "text": "Carmen has taste, and so do you, señor. But my Salamanca pages are complete already, safe under lock. What I can offer is the gold pack, 504 P. A serious visitor deserves nothing less.", "thread": 2619, "with": "pilar"}, "scope": "public", "t": 14.9792, "tick": 1769, "type": "thread.message"}
{"actor": "chato", "id": 81276, "payload": {"kind": "persona", "message": 14651, "offer": {"created_tick": 1769, "expires_tick": 1777, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:CHA-06"]}, "id": 22566, "maker": "chato", "status": "open", "thread": 2618, "to": "t10", "venue": null, "want": {"assets": [], "cash": 33, "types": []}}, "sender": "chato", "team": "t10", "text": "Carmen manda, bien. Pero el tren fantasma no abarata nada. Chamberí, 33 P. Tú no te has movido; yo tampoco.", "thread": 2618, "with": "chato"}, "scope": "public", "t": 14.9792, "tick": 1769, "type": "thread.message"}
