{"actor": "picaros", "id": 81161, "payload": {"kind": "persona", "message": 14625, "offer": {"created_tick": 1763, "expires_tick": 1771, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:MAL-09"]}, "id": 22536, "maker": "picaros", "status": "open", "thread": 2617, "to": "t05", "venue": null, "want": {"assets": [], "cash": 73, "types": []}}, "sender": "picaros", "team": "t05", "text": "¡Amigo, amiga, come close! Paco, show them — La Heroína del Dos de Mayo, the real thing, she glows in the right light. Seventy-three P, that's it. The team next door was sniffing around her, breathing on the case... but we like your faces better. Decide quick, eh?", "thread": 2617, "with": "picaros"}, "scope": "public", "t": 14.9542, "tick": 1763, "type": "thread.message"}
