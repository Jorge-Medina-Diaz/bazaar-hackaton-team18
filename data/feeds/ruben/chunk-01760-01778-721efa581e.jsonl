{"actor": "chato", "id": 81176, "payload": {"kind": "persona", "message": 14629, "offer": {"created_tick": 1764, "expires_tick": 1772, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:CHA-06"]}, "id": 22540, "maker": "chato", "status": "open", "thread": 2618, "to": "t10", "venue": null, "want": {"assets": [], "cash": 33, "types": []}}, "sender": "chato", "team": "t10", "text": "Buenas. Bonita ruta. La Chamberí vale 33 P. Los churros te los pagas tú.", "thread": 2618, "with": "chato"}, "scope": "public", "t": 14.9583, "tick": 1764, "type": "thread.message"}
