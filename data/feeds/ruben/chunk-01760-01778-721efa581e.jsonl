{"actor": "picaros", "id": 81354, "payload": {"kind": "persona", "message": 14666, "offer": {"created_tick": 1776, "expires_tick": 1784, "final": true, "give": {"assets": [], "cash": 4, "types": []}, "id": 22588, "maker": "picaros", "status": "open", "thread": 2629, "to": "t05", "venue": null, "want": {"assets": [{"id": 1195, "kind": "card", "print_run": 300, "rarity": "common", "ref": "LAT-01", "serial": 25, "set": "LAT"}], "cash": 0, "types": []}}, "sender": "picaros", "team": "t05", "text": "Oh, you're killing us. 4 P. Last offer, amigo! Then we are gone, eh? They stopped printing this one yesterday.", "thread": 2629, "with": "picaros"}, "scope": "public", "t": 15.0083, "tick": 1776, "type": "thread.message"}
