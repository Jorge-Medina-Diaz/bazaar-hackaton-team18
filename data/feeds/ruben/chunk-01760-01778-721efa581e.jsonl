{"actor": "picaros", "id": 81189, "payload": {"kind": "persona", "message": 14633, "offer": {"created_tick": 1765, "expires_tick": 1773, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:MAL-06"]}, "id": 22544, "maker": "picaros", "status": "open", "thread": 2617, "to": "t05", "venue": null, "want": {"assets": [], "cash": 60, "types": []}}, "sender": "picaros", "team": "t05", "text": "¡Ay, forty-two! Nando, hold me, I'm falling. Amigo, she's a heroína, not a postcard — sixty P and she walks home with you today. Paco's already wrapping her, look at his hands shaking. Say sí before the team next door comes back breathing on our case, eh?", "thread": 2617, "with": "picaros"}, "scope": "public", "t": 14.9625, "tick": 1765, "type": "thread.message"}
