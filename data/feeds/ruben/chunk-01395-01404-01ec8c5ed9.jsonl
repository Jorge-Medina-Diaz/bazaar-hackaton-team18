{"actor": "picaros", "id": 71805, "payload": {"kind": "persona", "message": 12446, "offer": {"created_tick": 1397, "expires_tick": 1401, "final": true, "give": {"assets": [], "cash": 4, "types": []}, "id": 19812, "maker": "picaros", "status": "open", "thread": 2150, "to": "t07", "venue": null, "want": {"assets": [{"id": 1092, "kind": "card", "print_run": 300, "rarity": "common", "ref": "LAV-03", "serial": 27, "set": "LAV"}], "cash": 0, "types": []}}, "sender": "picaros", "team": "t07", "text": "Oh, you're killing us. 4 P. Last offer, amigo! Then we are gone, eh?", "thread": 2150, "with": "picaros"}, "scope": "public", "t": 12.9667, "tick": 1397, "type": "thread.message"}
