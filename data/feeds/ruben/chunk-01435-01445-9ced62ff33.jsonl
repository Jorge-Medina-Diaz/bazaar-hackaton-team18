{"actor": "picaros", "id": 73182, "payload": {"kind": "persona", "message": 12701, "offer": {"created_tick": 1436, "expires_tick": 1440, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:RET-10"]}, "id": 20222, "maker": "picaros", "status": "open", "thread": 2209, "to": "t01", "venue": null, "want": {"assets": [], "cash": 73, "types": []}}, "sender": "picaros", "team": "t01", "text": "¡Amigo, qué ojo tiene usted! Paco, saca la pieza… ¡el Monumento a Alfonso XII, en gloria! Mire ese barniz, nadie la tiene. Nando se la deja en 73. Sí, 73, y porque nos cae bien, que a otro le pedimos el doble. ¿Cerramos ya? El tren no espera.", "thread": 2209, "with": "picaros"}, "scope": "public", "t": 13.2917, "tick": 1436, "type": "thread.message"}
