{"actor": "pilar", "id": 73213, "payload": {"kind": "persona", "message": 12708, "offer": {"created_tick": 1438, "expires_tick": 1442, "final": false, "give": {"assets": [], "cash": 63, "types": []}, "id": 20234, "maker": "pilar", "status": "open", "thread": 2210, "to": "t04", "venue": null, "want": {"assets": [{"id": 1176, "kind": "card", "print_run": 30, "rarity": "rare", "ref": "SAL-09", "serial": 28, "set": "SAL"}], "cash": 0, "types": []}}, "sender": "pilar", "team": "t04", "text": "Don Ernesto recibe solo a los más consumados, y solo los domingos — pero aquí se paga en el acto. Suba usted un escalón conmigo: 63 P por El Marqués. Precio justo, dicho con toda cortesía.", "thread": 2210, "with": "pilar"}, "scope": "public", "t": 13.3083, "tick": 1438, "type": "thread.message"}
