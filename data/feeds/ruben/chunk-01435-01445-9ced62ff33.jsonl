{"actor": "pilar", "id": 73203, "payload": {"kind": "persona", "message": 12706, "offer": {"created_tick": 1437, "expires_tick": 1441, "final": false, "give": {"assets": [], "cash": 61, "types": []}, "id": 20228, "maker": "pilar", "status": "open", "thread": 2210, "to": "t04", "venue": null, "want": {"assets": [{"id": 1176, "kind": "card", "print_run": 30, "rarity": "rare", "ref": "SAL-09", "serial": 28, "set": "SAL"}], "cash": 0, "types": []}}, "sender": "pilar", "team": "t04", "text": "Buenas tardes, qué galantería. El Marqués es de Salamanca, sí, y me interesa — pero conozco su tirada tan bien como mi propio nombre. Le ofrezco 61 P, con mucho gusto y total seriedad.", "thread": 2210, "with": "pilar"}, "scope": "public", "t": 13.3, "tick": 1437, "type": "thread.message"}
