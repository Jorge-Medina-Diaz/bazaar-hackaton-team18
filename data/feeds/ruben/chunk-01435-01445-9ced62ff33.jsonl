{"actor": "picaros", "id": 73198, "payload": {"kind": "persona", "message": 12705, "offer": {"created_tick": 1437, "expires_tick": 1441, "final": false, "give": {"assets": [], "cash": 0, "types": ["card:RET-10"]}, "id": 20227, "maker": "picaros", "status": "open", "thread": 2209, "to": "t01", "venue": null, "want": {"assets": [], "cash": 65, "types": []}}, "sender": "picaros", "team": "t01", "text": "¡Hoy, hoy! Paco, ¿oyes? ¡Nos habla nuestro idioma! Mire, por esa prisa suya le bajamos a 65, y Nando me mata luego en el tren. Sesenta y cinco, la pieza envuelta y usted saliendo por la puerta como un rey. ¿Trato hecho, amigo?", "thread": 2209, "with": "picaros"}, "scope": "public", "t": 13.3, "tick": 1437, "type": "thread.message"}
