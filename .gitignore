# Secrets: the team key lives only in .env on the executor machine (machine A).
.env
.env*
!.env.example
*.key
config/local*.json

# Kill switch files (python3 bazaar.py stop, or a hand-made STOP / STOP.txt / stop in the repo root)
/STOP*
/stop*

# Runtime state and evidence: local to each machine, never committed
/state/
logs/
runs/

# Generated
*.pyc
__pycache__/
.pytest_cache/
.venv/

# Claude Code worktrees (night-build, night-docs, ...): local only
/.claude/
